{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(sudo *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
